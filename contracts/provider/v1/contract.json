{
  "description": "agentbox.provider v1: host-only control between Agentbox and a trusted jail provider. See README.md.",
  "protocol": "agentbox.provider",
  "version": 1,
  "status": "codecs and exchange checks in host and providers; QEMU and Podman provider lifecycles implemented and tested offline; host lifecycle (custody, per-operation process fact, fresh-domain standalone cleanup, settlement gating) implemented offline, not accepted",
  "limits": {
    "max_frame_bytes": 16384,
    "max_depth": 3,
    "max_id_bytes": 64,
    "max_path_bytes": 4096,
    "max_provider_bytes": 32,
    "max_user_bytes": 32,
    "max_timeout_ms": 86400000,
    "max_safe_integer": 9007199254740991,
    "max_diagnostic_bytes": 65536,
    "cancel_grace_ms": 30000
  },
  "argv": {
    "control": ["control", "STATE"],
    "connect": ["connect", "STATE", "RUN", "EXECUTION", "INSTANCE"],
    "error": "invalid_argv"
  },
  "operations": {
    "required": ["capabilities", "prepare", "create", "start", "status", "stop", "discard"],
    "optional": ["checkpoint", "restore"]
  },
  "host_types": ["capabilities", "prepare", "create", "start", "status", "stop", "discard", "checkpoint", "restore", "cancel"],
  "provider_types": ["described", "prepared", "created", "started", "reported", "stopped", "discarded", "checkpointed", "restored", "failed"],
  "results": {
    "capabilities": "described",
    "prepare": "prepared",
    "create": "created",
    "start": "started",
    "status": "reported",
    "stop": "stopped",
    "discard": "discarded",
    "checkpoint": "checkpointed",
    "restore": "restored"
  },
  "fields": {
    "capabilities": {"required": ["operation", "timeout_ms"], "optional": []},
    "prepare": {"required": ["operation", "timeout_ms", "recipe", "worker"], "optional": []},
    "create": {"required": ["operation", "timeout_ms", "run", "resource", "image", "retention", "user"], "optional": ["mounts"]},
    "start": {"required": ["operation", "timeout_ms", "run", "resource", "execution", "instance", "generation", "accept_unclean", "authorized_key", "limits"], "optional": []},
    "status": {"required": ["operation", "timeout_ms", "run", "resource"], "optional": ["execution", "instance"]},
    "stop": {"required": ["operation", "timeout_ms", "run", "resource", "execution", "instance", "generation"], "optional": []},
    "discard": {"required": ["operation", "timeout_ms", "run", "resource"], "optional": ["checkpoint"]},
    "checkpoint": {"required": ["operation", "timeout_ms", "run", "resource", "checkpoint", "generation", "accept_unclean"], "optional": []},
    "restore": {"required": ["operation", "timeout_ms", "run", "resource", "checkpoint", "generation"], "optional": []},
    "cancel": {"required": ["operation"], "optional": []},
    "described": {"required": ["operation", "provider", "operations", "transport", "retention", "limits", "features"], "optional": []},
    "prepared": {"required": ["operation", "image", "worker_sha256"], "optional": ["agents"]},
    "created": {"required": ["operation", "run", "resource", "retention", "generation", "user", "home"], "optional": ["volume"]},
    "started": {"required": ["operation", "run", "resource", "execution", "instance", "generation", "transport", "user", "host_key", "worker_sha256", "home", "control"], "optional": []},
    "reported": {"required": ["operation", "run", "resource", "resource_state", "generation"], "optional": ["execution", "instance", "instance_state"]},
    "stopped": {"required": ["operation", "run", "resource", "execution", "instance", "settlement", "durability", "generation", "storage"], "optional": []},
    "discarded": {"required": ["operation", "run", "resource", "settlement"], "optional": ["checkpoint"]},
    "checkpointed": {"required": ["operation", "run", "resource", "checkpoint", "generation", "storage"], "optional": []},
    "restored": {"required": ["operation", "run", "resource", "checkpoint", "generation", "storage"], "optional": []},
    "failed": {"required": ["operation", "op", "code", "settlement", "durability"], "optional": []}
  },
  "transports": ["tcp", "stdio"],
  "tcp_hosts": ["127.0.0.1", "::1"],
  "retention": ["none", "home", "home_tmp", "disk"],
  "features": ["select_user", "project_layout", "host_mounts", "explicit_retention"],
  "mounts": {"max": 8, "max_path_bytes": 768, "access": ["ro", "rw"]},
  "default_user": "agentbox",
  "agents": ["pi", "codex", "claude"],
  "limit_ranges": {
    "cpus": [1, 256],
    "memory_mib": [64, 1048576],
    "pids": [1, 1048576],
    "disk_mib": [1, 16777216]
  },
  "settlement": ["settled", "unsettled", "unknown"],
  "durability": ["unchanged", "retained", "uncertain"],
  "storage": ["clean", "unclean"],
  "resource_states": ["absent", "ready", "unclean", "busy", "partial"],
  "instance_states": ["absent", "live", "settled", "unsettled"],
  "failure_codes": ["unsupported", "not_found", "binding_mismatch", "exists", "busy", "generation_mismatch", "unclean", "partial", "prerequisite", "cancelled", "timeout", "failed", "user_conflict", "mount_source_unavailable", "mount_source_unsupported", "mount_source_protected", "mount_source_overlap", "mount_destination_unsafe", "mounts_need_memory", "shared_store_uninitialized", "shared_image_missing", "retained_home_missing"],
  "lost_uncertain": ["create", "start", "stop", "discard", "restore"],
  "frame_error_codes": [
    "frame_too_large",
    "truncated_frame",
    "invalid_framing",
    "invalid_encoding",
    "invalid_json",
    "invalid_number",
    "duplicate_key",
    "not_object",
    "invalid_version",
    "unsupported_version",
    "unknown_type",
    "wrong_direction",
    "unknown_field",
    "missing_field",
    "invalid_field",
    "limit_exceeded"
  ],
  "exchange_error_codes": [
    "unsupported_operation",
    "unsupported_capability",
    "operation_mismatch",
    "binding_mismatch",
    "generation_mismatch",
    "worker_mismatch",
    "capability_mismatch",
    "unexpected_frame"
  ]
}
