{
  "description": "Guest-only classification of the argv after git into the supported v1 forms. result is clone (canonical repository and URL, optional selector, destination directory, optional -C directory), fetch (remote, optional -C directory), pull (optional integration flag, optional -C directory), local pass-through or a fixed refusal code. Classification is usability, not a security boundary.",
  "commands": [
    {
      "name": "clone",
      "argv": [
        "clone",
        "https://github.com/octocat/hello-world"
      ],
      "result": {
        "kind": "clone",
        "repository": "octocat/hello-world",
        "url": "https://github.com/octocat/hello-world.git",
        "directory": "hello-world"
      }
    },
    {
